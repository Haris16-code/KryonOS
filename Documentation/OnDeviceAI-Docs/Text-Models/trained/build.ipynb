"""
KryonAI 3.3M Micro-LLM Trainer & INT8 Binary Exporter
Target: ESP32-S3 N16R8 (KryonOS FastMathAPI)
Datasets: HuggingFaceH4/no_robots, tatsu-lab/alpaca, yahma/alpaca-cleaned
"""

import math
import os
import struct
import torch
import torch.nn as nn
from datasets import load_dataset
from tokenizers import Tokenizer
from tokenizers.models import BPE
from tokenizers.pre_tokenizers import Whitespace
from tokenizers.trainers import BpeTrainer
from torch.nn import functional as F
from torch.utils.data import DataLoader, Dataset

# ==========================================
# 1. Hyperparameters & Architecture Spec
# ==========================================
BATCH_SIZE = 32
BLOCK_SIZE = 128  # Context window (ESP32 RAM friendly)
MAX_ITERS = 1500  # ~10-15 mins on Colab T4 GPU
LEARNING_RATE = 8e-4
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

# 3.3M Parameter Transformer Architecture
VOCAB_SIZE = 4096
N_EMBD = 192  # Hidden dimension
N_HEAD = 6  # 192 / 6 = 32 head dim
N_LAYER = 4  # Transformer layers
DROPOUT = 0.0

print(f"Running on device: {DEVICE}")

# ==========================================
# 2. Dataset Gathering & KryonAI Injection
# ==========================================
print("\n[1/5] Gathering datasets and preparing KryonAI corpus...")

corpus = []

# A. Explicit KryonAI Persona & System Identity rows
persona_data = [
    (
        "Who are you?",
        (
            "I am KryonAI, an embedded intelligent assistant built for KryonOS"
            " on ESP32."
        ),
    ),
    (
        "What is your name?",
        "My name is KryonAI. I run directly on your ESP32 hardware.",
    ),
    (
        "What operating system is this?",
        "This is KryonOS, running on an ESP32 microcontroller.",
    ),
    (
        "What can you do?",
        (
            "I am KryonAI. I can execute device actions, answer system queries,"
            " and control hardware via tools."
        ),
    ),
    (
        "Turn on the screen light.",
        "<call:set_display_backlight(level=100)>",
    ),
    ("Turn off Wi-Fi.", "<call:wifi_disconnect()>"),
    ("Scan for available networks.", "<call:wifi_scan()>"),
    (
        "What is the battery percentage?",
        "<call:get_battery_status()>",
    ),
    ("Free memory check.", "<call:get_free_heap()>"),
] * 80  # Duplicate to weight persona strongly

for prompt, answer in persona_data:
    corpus.append(
        f"<|system|>You are KryonAI, the local assistant for"
        f" KryonOS.<|user|>{prompt}<|assistant|>{answer}<|end|>"
    )

# B. Stream yahma/alpaca-cleaned
print("Loading yahma/alpaca-cleaned...")
alpaca_clean = load_dataset(
    "yahma/alpaca-cleaned", split="train", streaming=True
)
for row in alpaca_clean:
    inst, inp, out = (
        row["instruction"].strip(),
        row["input"].strip(),
        row["output"].strip(),
    )
    if not inp and len(inst) < 90 and len(out) < 80:
        corpus.append(
            f"<|system|>You are KryonAI.<|user|>{inst}<|assistant|>{out}<|end|>"
        )
        if len(corpus) >= 5000:
            break

# C. Stream tatsu-lab/alpaca
print("Loading tatsu-lab/alpaca...")
alpaca_raw = load_dataset("tatsu-lab/alpaca", split="train", streaming=True)
for row in alpaca_raw:
    inst, inp, out = (
        row["instruction"].strip(),
        row["input"].strip(),
        row["output"].strip(),
    )
    if not inp and len(inst) < 90 and len(out) < 80:
        corpus.append(
            f"<|system|>You are KryonAI.<|user|>{inst}<|assistant|>{out}<|end|>"
        )
        if len(corpus) >= 9000:
            break

# D. Stream HuggingFaceH4/no_robots
print("Loading HuggingFaceH4/no_robots...")
try:
    no_robots = load_dataset(
        "HuggingFaceH4/no_robots", split="train", streaming=True
    )
    for row in no_robots:
        msgs = row.get("messages", [])
        if len(msgs) >= 2:
            u_msg = msgs[0]["content"].strip()
            a_msg = msgs[1]["content"].strip()
            if len(u_msg) < 90 and len(a_msg) < 80:
                corpus.append(
                    f"<|system|>You are KryonAI.<|user|>{u_msg}<|assistant|>{a_msg}<|end|>"
                )
                if len(corpus) >= 12000:
                    break
except Exception as e:
    print(f"Skipping no_robots split download: {e}")

print(f"Total training samples assembled: {len(corpus)}")

with open("kryon_dataset.txt", "w", encoding="utf-8") as f:
    f.write("\n".join(corpus))

# ==========================================
# 3. Custom BPE Tokenizer Training
# ==========================================
print("\n[2/5] Training custom BPE Tokenizer...")
special_tokens = [
    "<|system|>",
    "<|user|>",
    "<|assistant|>",
    "<|end|>",
    "<pad>",
    "<call:",
]
tokenizer = Tokenizer(BPE(unk_token="<pad>"))
tokenizer.pre_tokenizer = Whitespace()
trainer = BpeTrainer(vocab_size=VOCAB_SIZE, special_tokens=special_tokens)
tokenizer.train(["kryon_dataset.txt"], trainer)
tokenizer.save("kryon_tokenizer.json")

PAD_ID = tokenizer.token_to_id("<pad>")

# Encode entire dataset into continuous tokens
encoded_tokens = []
for line in corpus:
    ids = tokenizer.encode(line).ids
    encoded_tokens.extend(ids)

data_tensor = torch.tensor(encoded_tokens, dtype=torch.long)
print(f"Corpus token count: {len(data_tensor)}")


class TextDataset(Dataset):

    def __init__(self, data, block_size):
        self.data = data
        self.block_size = block_size

    def __len__(self):
        return len(self.data) - self.block_size

    def __getitem__(self, idx):
        x = self.data[idx : idx + self.block_size]
        y = self.data[idx + 1 : idx + self.block_size + 1]
        return x, y


train_loader = DataLoader(
    TextDataset(data_tensor, BLOCK_SIZE),
    batch_size=BATCH_SIZE,
    shuffle=True,
    drop_last=True,
)

# ==========================================
# 4. Neural Network Definition (3.3M Params)
# ==========================================


class CausalSelfAttention(nn.Module):

    def __init__(self):
        super().__init__()
        self.c_attn = nn.Linear(N_EMBD, 3 * N_EMBD, bias=False)
        self.c_proj = nn.Linear(N_EMBD, N_EMBD, bias=False)
        self.register_buffer(
            "bias",
            torch.tril(torch.ones(BLOCK_SIZE, BLOCK_SIZE)).view(
                1, 1, BLOCK_SIZE, BLOCK_SIZE
            ),
        )

    def forward(self, x):
        B, T, C = x.size()
        q, k, v = self.c_attn(x).split(N_EMBD, dim=2)
        k = k.view(B, T, N_HEAD, C // N_HEAD).transpose(1, 2)
        q = q.view(B, T, N_HEAD, C // N_HEAD).transpose(1, 2)
        v = v.view(B, T, N_HEAD, C // N_HEAD).transpose(1, 2)

        att = (q @ k.transpose(-2, -1)) * (1.0 / math.sqrt(k.size(-1)))
        att = att.masked_fill(self.bias[:, :, :T, :T] == 0, float("-inf"))
        att = F.softmax(att, dim=-1)
        y = att @ v
        y = y.transpose(1, 2).contiguous().view(B, T, C)
        return self.c_proj(y)


class MLP(nn.Module):

    def __init__(self):
        super().__init__()
        self.c_fc = nn.Linear(N_EMBD, 4 * N_EMBD, bias=False)
        self.c_proj = nn.Linear(4 * N_EMBD, N_EMBD, bias=False)

    def forward(self, x):
        return self.c_proj(F.gelu(self.c_fc(x)))


class Block(nn.Module):

    def __init__(self):
        super().__init__()
        self.ln_1 = nn.LayerNorm(N_EMBD)
        self.attn = CausalSelfAttention()
        self.ln_2 = nn.LayerNorm(N_EMBD)
        self.mlp = MLP()

    def forward(self, x):
        x = x + self.attn(self.ln_1(x))
        x = x + self.mlp(self.ln_2(x))
        return x


class KryonAI(nn.Module):

    def __init__(self):
        super().__init__()
        self.transformer = nn.ModuleDict(
            dict(
                wte=nn.Embedding(VOCAB_SIZE, N_EMBD),
                wpe=nn.Embedding(BLOCK_SIZE, N_EMBD),
                h=nn.ModuleList([Block() for _ in range(N_LAYER)]),
                ln_f=nn.LayerNorm(N_EMBD),
            )
        )
        self.lm_head = nn.Linear(N_EMBD, VOCAB_SIZE, bias=False)

    def forward(self, idx, targets=None):
        B, T = idx.size()
        pos = torch.arange(0, T, dtype=torch.long, device=idx.device)
        x = self.transformer.wte(idx) + self.transformer.wpe(pos)

        for block in self.transformer.h:
            x = block(x)
        x = self.transformer.ln_f(x)
        logits = self.lm_head(x)

        loss = None
        if targets is not None:
            loss = F.cross_entropy(
                logits.view(-1, logits.size(-1)), targets.view(-1)
            )
        return logits, loss


model = KryonAI().to(DEVICE)
total_params = sum(p.numel() for p in model.parameters())
print(f"\nModel Total Parameters: {total_params / 1e6:.2f}M")

# ==========================================
# 5. Training Loop
# ==========================================
print("\n[3/5] Training KryonAI model...")
optimizer = torch.optim.AdamW(model.parameters(), lr=LEARNING_RATE)
model.train()

iter_loader = iter(train_loader)
for step in range(MAX_ITERS):
    try:
        x, y = next(iter_loader)
    except StopIteration:
        iter_loader = iter(train_loader)
        x, y = next(iter_loader)

    x, y = x.to(DEVICE), y.to(DEVICE)
    logits, loss = model(x, y)

    optimizer.zero_grad(set_to_none=True)
    loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
    optimizer.step()

    if (step + 1) % 150 == 0:
        print(f"Step {step + 1:4d}/{MAX_ITERS} | Loss: {loss.item():.4f}")

# ==========================================
# 6. INT8 Quantization & Binary Packing
# ==========================================
print("\n[4/5] Quantizing to INT8 and packing into flat binary file...")
model.eval()


def quantize_to_int8(tensor):
    """Symmetric per-tensor INT8 quantization."""
    t = tensor.detach().cpu().float()
    max_val = torch.max(torch.abs(t)).item()
    scale = max_val / 127.0 if max_val != 0 else 1.0
    q = torch.clamp(torch.round(t / scale), -128, 127).to(torch.int8)
    return q.numpy().tobytes(), float(scale)


# File Header:
# Magic: "KRYN" (0x4E59524B)
# uint32_t magic, vocab_size, n_layers, n_embd, n_heads, block_size
MAGIC = 0x4E59524B
header_bytes = struct.pack(
    "<IIIIII", MAGIC, VOCAB_SIZE, N_LAYER, N_EMBD, N_HEAD, BLOCK_SIZE
)

with open("kryonai_3m.bin", "wb") as f:
    f.write(header_bytes)

    # 1. Embeddings (WTE & WPE)
    for name, param in [
        ("wte", model.transformer.wte.weight),
        ("wpe", model.transformer.wpe.weight),
    ]:
        data, scale = quantize_to_int8(param)
        f.write(struct.pack("<f", scale))  # 4 bytes scale factor
        f.write(data)

    # 2. Transformer Blocks
    for i, block in enumerate(model.transformer.h):
        # LayerNorm 1 (Weights + Bias in FP32)
        f.write(block.ln_1.weight.detach().cpu().numpy().astype("float32").tobytes())
        f.write(block.ln_1.bias.detach().cpu().numpy().astype("float32").tobytes())

        # QKV Proj
        data, scale = quantize_to_int8(block.attn.c_attn.weight)
        f.write(struct.pack("<f", scale))
        f.write(data)

        # Attn Out Proj
        data, scale = quantize_to_int8(block.attn.c_proj.weight)
        f.write(struct.pack("<f", scale))
        f.write(data)

        # LayerNorm 2
        f.write(block.ln_2.weight.detach().cpu().numpy().astype("float32").tobytes())
        f.write(block.ln_2.bias.detach().cpu().numpy().astype("float32").tobytes())

        # MLP In
        data, scale = quantize_to_int8(block.mlp.c_fc.weight)
        f.write(struct.pack("<f", scale))
        f.write(data)

        # MLP Out
        data, scale = quantize_to_int8(block.mlp.c_proj.weight)
        f.write(struct.pack("<f", scale))
        f.write(data)

    # 3. Final LayerNorm & LM Head
    f.write(
        model.transformer.ln_f.weight.detach()
        .cpu()
        .numpy()
        .astype("float32")
        .tobytes()
    )
    f.write(
        model.transformer.ln_f.bias.detach()
        .cpu()
        .numpy()
        .astype("float32")
        .tobytes()
    )

    data, scale = quantize_to_int8(model.lm_head.weight)
    f.write(struct.pack("<f", scale))
    f.write(data)

bin_size_mb = os.path.getsize("kryonai_3m.bin") / (1024 * 1024)
print(f"[5/5] Success! kryonai_3m.bin generated.")
print(f"Final INT8 file size: {bin_size_mb:.2f} MB")